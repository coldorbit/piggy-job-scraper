{
  "name": "sites-scraper",
  "version": "1.0.0",
  "private": true,
  "description": "Standalone site scrapers for remote job listings.",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "test": "node --test",
    "jobs:reclassify-recent": "node sites/maintenance/reclassifyRecentJobs.js",
    "jobs:backfill-attributes": "node sites/maintenance/backfillJobAttributes.js",
    "scrape": "pnpm jobright:scrape && pnpm jobright:ca:scrape && pnpm jobright:uk:scrape && pnpm builtin:scrape && pnpm remotehunter:scrape && pnpm hiringcafe:scrape",
    "watch": "pnpm jobright:watch & pnpm jobright:ca:watch & pnpm jobright:uk:watch & pnpm builtin:watch & pnpm remotehunter:watch & pnpm hiringcafe:watch & wait",
    "jobright:scrape": "node sites/jobright/scraper.js --country us",
    "jobright:watch": "node sites/jobright/scraper.js --country us --watch --watch-interval-minutes 10 --max-scrolls 30 --detail-concurrency 2",
    "jobright:ca:scrape": "node sites/jobright/scraper.js --country ca",
    "jobright:ca:watch": "node sites/jobright/scraper.js --country ca --watch --watch-interval-minutes 10 --max-scrolls 30 --detail-concurrency 2",
    "jobright:uk:scrape": "node sites/jobright/scraper.js --country uk",
    "jobright:uk:watch": "node sites/jobright/scraper.js --country uk --watch --watch-interval-minutes 10 --max-scrolls 30 --detail-concurrency 2",
    "linkedin:scrape": "node -e \"console.log('LinkedIn scraper disabled; skipping.')\"",
    "linkedin:watch": "node -e \"console.log('LinkedIn scraper disabled; skipping watch.')\"",
    "builtin:scrape": "node sites/builtin/scraper.js",
    "builtin:watch": "node sites/builtin/scraper.js --watch --watch-interval-minutes 5",
    "simplify:scrape": "node -e \"console.log('Simplify scraper disabled; skipping.')\"",
    "simplify:watch": "node -e \"console.log('Simplify scraper disabled; skipping watch.')\"",
    "diversityjobs:scrape": "node -e \"console.log('DiversityJobs scraper disabled; skipping.')\"",
    "diversityjobs:watch": "node -e \"console.log('DiversityJobs scraper disabled; skipping watch.')\"",
    "remoteyeah:scrape": "node -e \"console.log('RemoteYeah scraper disabled; skipping.')\"",
    "remoteyeah:watch": "node -e \"console.log('RemoteYeah scraper disabled; skipping watch.')\"",
    "remotehunter:scrape": "node sites/remotehunter/scraper.js",
    "remotehunter:watch": "node sites/remotehunter/scraper.js --watch --watch-interval-minutes 5",
    "hiringcafe:scrape": "node sites/hiringcafe/scraper.js",
    "hiringcafe:watch": "node sites/hiringcafe/scraper.js --watch --watch-interval-minutes 5",
    "jobright:debug": "node sites/jobright/scraper.js --debug --no-headless",
    "install:browsers": "playwright install chromium"
  },
  "dependencies": {
    "axios": "^1.16.1",
    "dotenv": "^16.4.7",
    "pg": "^8.21.0",
    "playwright": "^1.52.0",
    "sequelize": "^6.37.8"
  }
}
